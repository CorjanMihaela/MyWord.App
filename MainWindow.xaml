<Window x:Class="MyWord.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyWord - Document nou"
        Height="760"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        Closing="Window_Closing">

    <DockPanel x:Name="MainRoot"
               Background="#F3F4F6">

        <!-- MENIU PRINCIPAL -->
        <Menu x:Name="MainMenu"
              DockPanel.Dock="Top"
              Background="White">

            <MenuItem Header="_Fișier">

                <MenuItem Header="_Document nou"
                          InputGestureText="Ctrl+N"
                          Click="New_Click"/>

                <MenuItem Header="_Deschide..."
                          InputGestureText="Ctrl+O"
                          Click="Open_Click"/>

                <MenuItem Header="_Salvează"
                          InputGestureText="Ctrl+S"
                          Click="Save_Click"/>

                <MenuItem Header="Salvează _ca..."
                          Click="SaveAs_Click"/>

                <Separator/>

                <MenuItem Header="Ieșire"
                          Click="Exit_Click"/>

            </MenuItem>

            <MenuItem Header="_Editare">

                <MenuItem Header="Anulează"
                          Command="ApplicationCommands.Undo"
                          CommandTarget="{Binding ElementName=Editor}"
                          InputGestureText="Ctrl+Z"/>

                <MenuItem Header="Refă"
                          Command="ApplicationCommands.Redo"
                          CommandTarget="{Binding ElementName=Editor}"
                          InputGestureText="Ctrl+Y"/>

                <Separator/>

                <MenuItem Header="Decupează"
                          Command="ApplicationCommands.Cut"
                          CommandTarget="{Binding ElementName=Editor}"
                          InputGestureText="Ctrl+X"/>

                <MenuItem Header="Copiază"
                          Command="ApplicationCommands.Copy"
                          CommandTarget="{Binding ElementName=Editor}"
                          InputGestureText="Ctrl+C"/>

                <MenuItem Header="Lipește"
                          Command="ApplicationCommands.Paste"
                          CommandTarget="{Binding ElementName=Editor}"
                          InputGestureText="Ctrl+V"/>

                <MenuItem Header="Selectează tot"
                          Command="ApplicationCommands.SelectAll"
                          CommandTarget="{Binding ElementName=Editor}"
                          InputGestureText="Ctrl+A"/>

            </MenuItem>

            <MenuItem Header="_Academic">

                <MenuItem Header="Aplică format academic"
                          Click="AcademicFormat_Click"/>

                <MenuItem Header="Text normal"
                          Click="NormalText_Click"/>

                <Separator/>

                <MenuItem Header="Capitol"
                          Click="Chapter_Click"/>

                <MenuItem Header="Subcapitol"
                          Click="Subchapter_Click"/>

                <Separator/>

                <MenuItem Header="Recalculează numerotarea"
                          Click="Renumber_Click"/>

            </MenuItem>

            <MenuItem Header="_Temă">

                <MenuItem Header="Temă deschisă"
                          Click="LightTheme_Click"/>

                <MenuItem Header="Temă întunecată"
                          Click="DarkTheme_Click"/>

            </MenuItem>

            <MenuItem Header="_Ajutor">

                <MenuItem Header="Despre MyWord"
                          Click="About_Click"/>

            </MenuItem>

        </Menu>

        <!-- TOOLBAR -->
        <Border x:Name="ToolbarBorder"
                DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#D9DEE7"
                BorderThickness="0,0,0,1"
                Padding="8">

            <WrapPanel VerticalAlignment="Center">

                <Button Content="📄 Document nou"
                        Click="New_Click"
                        Margin="3"
                        Padding="10,6"/>

                <Button Content="📂 Deschide"
                        Click="Open_Click"
                        Margin="3"
                        Padding="10,6"/>

                <Button Content="💾 Salvează"
                        Click="Save_Click"
                        Margin="3"
                        Padding="10,6"/>

                <Button Content="Salvează ca..."
                        Click="SaveAs_Click"
                        Margin="3"
                        Padding="10,6"/>

                <Separator Margin="8,0"/>

                <TextBlock Text="Font:"
                           VerticalAlignment="Center"
                           Margin="8,0,4,0"/>

                <ComboBox x:Name="FontBox"
                          Width="170"
                          Height="28"
                          SelectionChanged="Font_Changed"
                          Margin="3"/>

                <TextBlock Text="Dimensiune:"
                           VerticalAlignment="Center"
                           Margin="8,0,4,0"/>

                <ComboBox x:Name="SizeBox"
                          Width="65"
                          Height="28"
                          SelectionChanged="Size_Changed"
                          Margin="3"/>

                <Separator Margin="8,0"/>

                <ToggleButton Content="B"
                              FontWeight="Bold"
                              Width="34"
                              Height="30"
                              Margin="3"
                              ToolTip="Aldin"
                              Command="EditingCommands.ToggleBold"
                              CommandTarget="{Binding ElementName=Editor}"/>

                <ToggleButton Content="I"
                              FontStyle="Italic"
                              Width="34"
                              Height="30"
                              Margin="3"
                              ToolTip="Cursiv"
                              Command="EditingCommands.ToggleItalic"
                              CommandTarget="{Binding ElementName=Editor}"/>

                <ToggleButton Width="34"
                              Height="30"
                              Margin="3"
                              ToolTip="Subliniat"
                              Command="EditingCommands.ToggleUnderline"
                              CommandTarget="{Binding ElementName=Editor}">

                    <TextBlock Text="U"
                               TextDecorations="Underline"/>

                </ToggleButton>

                <Separator Margin="8,0"/>

                <Button Content="Stânga"
                        Margin="3"
                        Padding="8,5"
                        Command="EditingCommands.AlignLeft"
                        CommandTarget="{Binding ElementName=Editor}"/>

                <Button Content="Centru"
                        Margin="3"
                        Padding="8,5"
                        Command="EditingCommands.AlignCenter"
                        CommandTarget="{Binding ElementName=Editor}"/>

                <Button Content="Dreapta"
                        Margin="3"
                        Padding="8,5"
                        Command="EditingCommands.AlignRight"
                        CommandTarget="{Binding ElementName=Editor}"/>

                <Button Content="Justificat"
                        Margin="3"
                        Padding="8,5"
                        Command="EditingCommands.AlignJustify"
                        CommandTarget="{Binding ElementName=Editor}"/>

            </WrapPanel>

        </Border>

        <!-- BUTOANE ACADEMICE -->
        <Border x:Name="AcademicToolbar"
                DockPanel.Dock="Top"
                Background="#E8EEF9"
                BorderBrush="#C7D2E5"
                BorderThickness="0,0,0,1"
                Padding="8">

            <WrapPanel VerticalAlignment="Center">

                <TextBlock Text="Format academic:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="4,0,12,0"/>

                <Button Content="Text normal"
                        Click="NormalText_Click"
                        Margin="3"
                        Padding="12,6"
                        Background="#64748B"
                        Foreground="White"/>

                <Button Content="Capitol"
                        Click="Chapter_Click"
                        Margin="3"
                        Padding="12,6"
                        Background="#2563EB"
                        Foreground="White"/>

                <Button Content="Subcapitol"
                        Click="Subchapter_Click"
                        Margin="3"
                        Padding="12,6"
                        Background="#0F766E"
                        Foreground="White"/>

                <Button Content="Aplică format academic"
                        Click="AcademicFormat_Click"
                        Margin="12,3,3,3"
                        Padding="12,6"
                        Background="#7C3AED"
                        Foreground="White"/>

                <Button Content="Recalculează numerotarea"
                        Click="Renumber_Click"
                        Margin="3"
                        Padding="12,6"
                        Background="#475569"
                        Foreground="White"/>

            </WrapPanel>

        </Border>

        <!-- ZONA PRINCIPALĂ -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANOU LATERAL -->
            <Border x:Name="Sidebar"
                    Grid.Column="0"
                    Background="White"
                    BorderBrush="#D9DEE7"
                    BorderThickness="0,0,1,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="14">

                        <TextBlock Text="DOCUMENT"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="6,8,6,8"/>

                        <Button Content="＋ Document nou"
                                Click="New_Click"
                                Margin="3"
                                Padding="10,7"/>

                        <Button Content="📂 Deschide"
                                Click="Open_Click"
                                Margin="3"
                                Padding="10,7"/>

                        <Button Content="💾 Salvează"
                                Click="Save_Click"
                                Margin="3"
                                Padding="10,7"/>

                        <Button Content="Salvează ca..."
                                Click="SaveAs_Click"
                                Margin="3"
                                Padding="10,7"/>

                        <Separator Margin="4,14"/>

                        <TextBlock Text="STRUCTURĂ"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="6,8,6,8"/>

                        <Button Content="Capitol nou"
                                Click="Chapter_Click"
                                Margin="3"
                                Padding="10,7"
                                Background="#2563EB"
                                Foreground="White"/>

                        <Button Content="Subcapitol nou"
                                Click="Subchapter_Click"
                                Margin="3"
                                Padding="10,7"
                                Background="#0F766E"
                                Foreground="White"/>

                        <Button Content="Text normal"
                                Click="NormalText_Click"
                                Margin="3"
                                Padding="10,7"
                                Background="#64748B"
                                Foreground="White"/>

                        <Separator Margin="4,14"/>

                        <TextBlock Text="REGULI ACADEMICE"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="6,8,6,8"/>

                        <TextBlock Text="• Times New Roman 12"
                                   Margin="8,3"
                                   Foreground="#334155"/>

                        <TextBlock Text="• Spațiere între rânduri: 1,5"
                                   Margin="8,3"
                                   Foreground="#334155"/>

                        <TextBlock Text="• Spațiu înainte/după: 0"
                                   Margin="8,3"
                                   Foreground="#334155"/>

                        <TextBlock Text="• Indentare: 1,25 cm"
                                   Margin="8,3"
                                   Foreground="#334155"/>

                        <TextBlock Text="• Aliniere: justificată"
                                   Margin="8,3"
                                   Foreground="#334155"/>

                        <Separator Margin="4,14"/>

                        <TextBlock Text="STATISTICI"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="6,8,6,8"/>

                        <Border Background="#F1F5F9"
                                CornerRadius="8"
                                Padding="10"
                                Margin="3">

                            <StackPanel>

                                <TextBlock x:Name="WordsText"
                                           Text="Cuvinte: 0"
                                           Margin="0,3"
                                           Foreground="#334155"/>

                                <TextBlock x:Name="CharactersText"
                                           Text="Caractere: 0"
                                           Margin="0,3"
                                           Foreground="#334155"/>

                                <TextBlock x:Name="FileText"
                                           Text="Document nou"
                                           TextWrapping="Wrap"
                                           Margin="0,3"
                                           Foreground="#334155"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- EDITOR -->
            <Grid Grid.Column="1"
                  Margin="18">

                <Border x:Name="EditorBorder"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8">

                    <RichTextBox x:Name="Editor"
                                 Margin="4"
                                 Padding="30"
                                 AcceptsTab="True"
                                 SpellCheck.IsEnabled="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Times New Roman"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Background="White"
                                 TextChanged="Editor_TextChanged"
                                 PreviewKeyDown="Editor_PreviewKeyDown">

                        <FlowDocument PagePadding="20">

                            <Paragraph/>

                        </FlowDocument>

                    </RichTextBox>

                </Border>

            </Grid>

        </Grid>

        <!-- STATUS BAR -->
        <Border x:Name="StatusBorder"
                DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="#D9DEE7"
                BorderThickness="0,1,0,0"
                Padding="10,5">

            <DockPanel>

                <TextBlock x:Name="StatusText"
                           Text="Gata"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>

                <TextBlock Text="MyWord - Modul academic"
                           DockPanel.Dock="Right"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>

            </DockPanel>

        </Border>

    </DockPanel>

</Window>